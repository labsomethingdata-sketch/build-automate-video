# ── Supabase (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor — NUNCA con prefijo NEXT_PUBLIC (bypassa RLS):
SUPABASE_SERVICE_ROLE_KEY=

# ── Worker Modal ──
# URL del endpoint start_pipeline (modal deploy la imprime)
MODAL_START_PIPELINE_URL=

# ── AWS S3 (para firmar subidas desde el server) ──
AWS_REGION=us-east-1
S3_BUCKET=motor-de-videos-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
